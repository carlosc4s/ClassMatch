# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados do SEU banco.
# Se o .env não existir, o iniciar.bat pergunta usuário e senha e cria ele sozinho (MySQL).

# ---------- Opção 1: MySQL no computador (Workbench / XAMPP) ----------
DB_TIPO=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=classmatch_db

# ---------- Opção 2: Supabase (PostgreSQL na nuvem) ----------
# No site do Supabase: botão "Connect" > "Session pooler" (copie host, porta e usuário).
# DB_TIPO=postgres
# DB_HOST=aws-0-sa-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.SEU_ID_DO_PROJETO
# DB_PASSWORD=senha_do_banco_no_supabase
# DB_NAME=postgres
# DB_FUSO=America/Sao_Paulo

# Porta do site (http://127.0.0.1:5000). Só mude se a 5000 estiver ocupada.
PORTA=5000


# ---------- E-mail do ClassMatch (opcional, mas recomendado) ----------
# Usado para: "Esqueci minha senha", código de confirmação no cadastro e código para excluir a conta.
# Sem isto: a senha é trocada pela coordenação, o cadastro não pede código e a exclusão pede só a senha.
# Gmail: ative a "Verificação em duas etapas" na conta e crie uma "Senha de app" em
# https://myaccount.google.com/apppasswords  -> cole os 16 letras abaixo (com ou sem espaços).
# EMAIL_USUARIO=seu.email@gmail.com
# EMAIL_SENHA_APP=abcd efgh ijkl mnop
# Depois de preencher, teste com o backend/testar_email.bat
# Endereço usado no link do e-mail (padrão: http://127.0.0.1:5000)
# SITE_URL=http://127.0.0.1:5000

# ---------- Supabase Storage (só para versões antigas) ----------
# Desde a v6.4 o chat é só texto. Isto só serve para apagar arquivos antigos do Storage
# quando alguém exclui a conta.
# Supabase > Project Settings > API Keys > copie a chave "secret" (sb_secret_...) ou a "service_role".
# A chave é SECRETA: só neste arquivo, nunca no código nem no GitHub.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_CHAVE_SECRETA=cole_a_chave_aqui
