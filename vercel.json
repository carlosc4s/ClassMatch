{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo \"site estatico: pasta frontend\"",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend,frontend,database}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
